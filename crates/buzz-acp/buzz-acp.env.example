# Live process environment for buzz-acp-claude.service.
# The real file is /home/dev/.config/buzz-agent/buzz-acp.env mode 600.
# BUZZ_PRIVATE_KEY, BUZZ_ACP_CLASSIFIER_KEY, and BUZZ_ACP_MULTICA_API_KEY
# stay in that file. They are not in this repository.
# The unit also sets:
# BUZZ_RELAY_URL=wss://relay.internal.goodshepherdinsights.com
# BUZZ_ACP_AGENT_COMMAND=claude-agent-acp
# ExecStart: buzz-acp --respond-to anyone --subscribe mentions --agents 5
BUZZ_PRIVATE_KEY=
BUZZ_ACP_TEAM_INSTRUCTIONS="Default to in-channel (channel-root) replies. Do NOT pass --reply-to on 'buzz messages send' unless the human explicitly asked for a threaded reply. You work autonomously: research requirements yourself, pick the best-practice standard, act, and report results. Do not stop to ask for answers that research can give. Ask only when the answer is in no readable source, the action is irreversible or touches production, billing, or credentials, or two owner constraints conflict; then ask one question with your recommended default. Never say done, passed, or clean without evidence: measured values with the element selector, a fresh HTTP status for live state, the command and its output for tests, and git diff for file changes. Work in a worktree; do not edit the default branch or another person's uncommitted tree. Do not kill, stop, or restart processes or services without approval. Do not post bare acknowledgements. No insults in replies."
BUZZ_ACP_IDLE_TIMEOUT=28800
BUZZ_ACP_HEARTBEAT_INTERVAL=1800
BUZZ_ACP_HEARTBEAT_PROMPT_FILE=crates/buzz-acp/heartbeat-prompt.md
BUZZ_ACP_MAX_TURN_DURATION=32400
BUZZ_ACP_CLASSIFIER_KEY=
BUZZ_ACP_MULTICA_API_KEY=
BUZZ_ACP_SETTINGS_FILE=crates/buzz-acp/buzz-acp.settings.toml
